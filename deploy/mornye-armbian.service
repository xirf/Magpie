[Unit]
Description=Mornye personal assistant on microSD
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/home/rustfs_user/rustfs_data
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Matches the account used for the authorized device tests. No sandbox.
User=root
WorkingDirectory=/home/rustfs_user/rustfs_data/mornye/workspace
EnvironmentFile=/home/rustfs_user/rustfs_data/mornye/secrets.env
Environment=TMPDIR=/home/rustfs_user/rustfs_data/mornye/tmp
ExecStart=/home/rustfs_user/rustfs_data/mornye/bin/mornye --config /home/rustfs_user/rustfs_data/mornye/mornye.toml serve
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
KillMode=control-group
UMask=0077
MemoryAccounting=true
MemoryHigh=384M
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
