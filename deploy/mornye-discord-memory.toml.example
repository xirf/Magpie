# Copy to /home/rustfs_user/rustfs_data/mornye/mornye-discord-memory.toml
state_dir = "/home/rustfs_user/rustfs_data/mornye/state"
workspace = "/home/rustfs_user/rustfs_data/mornye/workspace-discord-memory"
api_base = "https://api.deepseek.com"
api_key_env = "DEEPSEEK_API_KEY"
model = "deepseek-flash"
max_steps = 16
max_context_bytes = 96000
max_output_tokens = 4096
command_timeout_secs = 120

# Required before starting the service. Set this to your Discord numeric user ID.
# discord_user_id = 123456789
# Optional: accept only this channel instead of owner DMs.
# discord_channel_id = 123456789
